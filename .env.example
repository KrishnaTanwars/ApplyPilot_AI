# MongoDB Configuration
MONGODB_URI=mongodb://localhost:27017/applypilot

# Gemini & Google Cloud Vertex AI Configuration
GEMINI_API_KEY=YOUR_GEMINI_API_KEY
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=us-central1
GOOGLE_APPLICATION_CREDENTIALS=./credentials.json

# Application URL
APP_URL=http://localhost:3000

# Security Secrets
SESSION_SECRET=development_session_secret_change_me_in_production
# 32-byte hex encryption key (64 characters)
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Local Storage Folders
BROWSER_PROFILE_DIR=./storage/browser-profile
RESUME_STORAGE_DIR=./storage/resumes
SCREENSHOT_STORAGE_DIR=./storage/screenshots

# Log Level: trace, debug, info, warn, error
LOG_LEVEL=info
